API_PORT=3000
# Max renders holding a Chrome page at once (others queue). Default 2.
MAX_CONCURRENT_RENDERS=2
# CDP call timeout for the shared Chrome, ms. Default 180000.
PROTOCOL_TIMEOUT_MS=180000
# Max wait for the page's network to go idle before rendering anyway, ms. Default 15000.
NETWORK_IDLE_TIMEOUT_MS=15000
